# --- App ---
APP_NAME=bfsi-ai-agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
CORRELATION_HEADER=X-Correlation-ID
CORS_ALLOWED_ORIGINS=["http://localhost:3001"]

# --- Security ---
# Generate: python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
ENCRYPTION_KEY=change-me-32-bytes-base64-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://bfsi:bfsi@localhost:5432/bfsi_ai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL_SECONDS=900

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=bfsi-ai-agent

# --- LLM Gateway ---
LLM_DEFAULT_PROVIDER=mock
LLM_DEFAULT_MODEL=bfsi-mock
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_RPM=600

# --- RAG / Vector ---
VECTOR_STORE=opensearch
OPENSEARCH_URL=http://localhost:9200
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
EMBEDDING_DIM=384
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=bfsi-agent-api
LOG_LEVEL=INFO

# --- Storage ---
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=bfsi-documents

# --- HITL / Compliance ---
HITL_APPROVAL_TIMEOUT_HOURS=72
AUDIT_RETENTION_DAYS=2555

# --- Decisioning ---
ELIGIBILITY_MIN_SCORE=550
FRAUD_MAX_RISK_SCORE=65
